set -euo pipefail

declare -r HERE="$( dirname "$( readlink -f "${BASH_SOURCE[0]:-$0}" )" )"
[[ '--setup' = "${1:-}" ]] && { shift; bash "${HERE}/setup.sh" "$@"; exit $?; }

# @credit: https://github.com/ppo/bash-colors
# @usage:  or copy & paste the `c()` function from - https://github.com/ppo/bash-colors/blob/master/bash-colors.sh#L3
declare -f c &>/dev/null || {
  source "${HERE}/utils/bash-colors.sh" || { c() { :; }; };
}

declare -r ME="$( basename "${BASH_SOURCE[0]:-$0}" | sed 's/-/ /' )"
declare -r USAGE="NAME
  $(c Cs)${ME}$(c) - smartify create a new PR with fzf or open exists PR

USAGE
  $(c Ys)\$ ${ME}$(c) $(c Wd)[$(c)$(c Gs)OPTIONS$(c)$(c Wd)]$(c)

OPTIONS
  $(c G)--setup$(c)              setup the gh-new script environment (e.g. feth submodules, set bash_completion, ...)
  $(c G)--force$(c)              force to re-install the bash completion, only for $(c 0Gi)--setup$(c) option

  $(c G)-o$(c), $(c G)--open$(c)           open the created PR in the web browser
  $(c G)-l$(c), $(c G)--label$(c) $(c 0Mi)LABEL$(c)    add label(s) to the created PR
                       $(c 0i)comma-separated or repeated; $(c 0Mi)'auto-merge'$(c 0i) is auto-applied (if applicate)$(c)
  $(c G)-v$(c), $(c G)--verbose$(c)        show verbose output
  $(c G)-a$(c), $(c G)--auto$(c)           automatically open the current PR if exists in current branch
  $(c G)-d$(c), $(c G)--draft$(c)          create the PR as a draft
  $(c G)-D$(c), $(c G)--dryrun$(c)         show the command to be executed, but do not run it
  $(c G)--no-ai$(c)              do not summarize a multi-commit PR title via '$(c i)claude -p$(c)'; use the latest commit subject
                       $(c 0i)env: $(c 0Mi)GH_NEW_AI_MODEL$(c 0i) ( default: haiku ), $(c 0Mi)GH_NEW_AI_TIMEOUT$(c 0i) ( seconds, default: 60 )$(c)
  $(c G)-h$(c), $(c G)--help$(c)           show this help message
  $(c B)--$(c) $(c 0Wdi)[$(c 0Ci)GH_OPTS$(c 0Wdi)]$(c)         pass all following arguments to the underlying '$(c i)gh pr create$(c)' command

EXAMPLES
  $(c 0Wdi)# create a PR from the current branch to a selected base branch$(c)
  $(c Ys)\$ ${ME}$(c)

  $(c 0Wdi)# create a PR and add labels$(c)
  $(c Ys)\$ ${ME} $(c 0Gi)--open --label $(c 0Mi)'bug' $(c 0Gi)--label $(c 0Mi)'enhancement,documentation'$(c)
  $(c Ys)\$ ${ME} $(c 0Gi)--open --label $(c 0Mi)'bug,enhancement'$(c)

  $(c 0Wdi)# open the web browser to create a pull request$(c)
  $(c Ys)\$ ${ME} $(c 0B)-- $(c 0Ci)--web$(c)

  $(c 0Wdi)# create a PR with reviewers$(c)
  $(c Ys)\$ ${ME} $(c 0B)-- $(c 0Ci)--reviewer USER,USER$(c)
"
declare DRYRUN=false
declare VERBOSE=false
declare AUTO=false
declare -a GH_OPTS=()
declare -a CLI_CMD=()
declare -a LABELS=()
declare OPEN=false
declare AI=true
# sed: strip the trailing PR ref ` (#123)` from the commit subject ( first line only )
declare -r PR_RE='1 s/[[:space:]]+\(#?[0-9]+\)[[:space:]]*$//'

function showHelp() { echo -e "${USAGE}"; exit 0; }
function joinBy {
  local d=${1-} f=${2-}
  if shift 2; then printf %s "$f" "${@/#/$d}"; fi
}
function _labelExists() { gh label list --json name --jq "any(.[].name; . == \"${1}\")" | grep -q '^true$'; }
function show() {
  local tag tcolor body extra
  local bcolor="$(c 0Wi)"
  local indicator="$(c 0Wdi)>>$(c)"

  case "$1" in
    info             ) tag="$1"; shift; body="${*}"; tcolor="$(c 0Gi)";  bcolor="$(c 0Wdi)" ;;
    warning          ) tag="$1"; shift; body="${*}"; tcolor="$(c 0Yi)";  bcolor="${tcolor}" ;;
    error            ) tag="$1"; shift; body="${*}"; tcolor="$(c 0Ri)"                      ;;
    dryrun | verbose ) tag="$1"; shift; body="${*}"; tcolor="$(c 0Wdi)"; bcolor="${tcolor}" ;;
    *                ) tag='error';     body="${*}"; tcolor="$(c 0Ri)"                      ;;
  esac

  [[ 'error' == "${tag}" ]] && extra="$(c Wdi). exit ...$(c)" || extra=''
  printf "%b%b %s$(c)%b: %b$(c)%b\n" "${indicator}" "${tcolor}" "${tag^^}" "${bcolor}" "${body}" "${extra}" >&2;
  [[ 'error' == "${tag}" ]] && exit 1 || :
}

function isPushed() {
  local branch="${1:-}"
  local main="${2:-}"
  test -z "${branch}" && show error 'branch name is required to push'
  local note=''

  [[ "${branch}" == "${main}" ]] && {
    show warning "cannot push to default branch \`$(c 0Yi)${main}$(c 0Wdi)\`"
    return 0
  }

  if ! git ls-remote --exit-code --heads origin "${branch}" >/dev/null 2>&1; then
    note="branch does not exist"
  else
    local lhash rhash
    git fetch origin "${branch}" >/dev/null 2>&1 || true
    lhash="$(git rev-parse "refs/heads/${branch}" 2>/dev/null)" || lhash=''
    rhash="$(git rev-parse "refs/remotes/origin/${branch}" 2>/dev/null)" || rhash=''
    [[ "${lhash}" != "${rhash}" ]] && note='local differs from remote'
  fi

  test -n "${note}" && {
    show info "pushing branch \`$(c 0Yi)${branch}$(c 0Wdi)\` (${note}) ..."
    git push -u origin "${branch}:refs/heads/${branch}" >/dev/null
  } || :
}

# print the PR title summarized by `claude -p` from the commit messages; empty on any failure
#   format : <type>[(<JIRA-ID>,...,<topic>,...)]: <summary> ( single line, <= 120 chars; JIRA IDs only when the commit scopes have any )
#   env    : GH_NEW_AI_MODEL ( default: haiku ), GH_NEW_AI_TIMEOUT ( seconds, default: 60 )
#   note   : call in a `$( ... )` subshell, the EXIT trap stays local there
function aiTitle() {
  local range="${1}"
  local commits="${2}"
  command -v claude >/dev/null 2>&1 || return 0

  local model="${GH_NEW_AI_MODEL:-haiku}"
  local secs="${GH_NEW_AI_TIMEOUT:-60}"
  local -r maxLen=120
  # JIRA IDs from the `type(scope)` of the commit subjects only, oldest first, deduplicated
  local -a ids=()
  mapfile -t ids < <( git log --reverse --pretty=%s "${range}" |
                      sed -nE 's/^[a-z]+\(([^)]*)\)!?:.*/\1/p' |
                      tr ',' '\n' | tr -d '[:blank:]' |
                      grep -E '^[A-Z][A-Z0-9]+-[0-9]+$' | awk '!seen[$0]++' || :
                    )
  local idRule='- no JIRA IDs: the parentheses hold the topics only; drop the parentheses when there is no topic either'
  test 0 -lt "${#ids[@]}" && idRule="- JIRA IDs: all of $( joinBy ',' "${ids[@]}" ), in this order, first inside the parentheses"
  local rules="You write ONE pull-request title for the git commits given on stdin ( oldest first, separated by --- ).
Rules:
- output ONLY the title: concise, a single line, at most ${maxLen} characters in total; no quotes, no backticks, no markdown, no explanation
- format: <type>(<JIRA-IDs>,<topics>): <summary>
- <type>: feat, fix, chore, docs, refactor, perf, test, build, ci, style or revert; feat if any commit is a feat, otherwise fix if any is a fix, otherwise the dominant type
- inside the parentheses: comma-separated, no spaces; JIRA IDs first, then the topics from the commit scopes, deduplicated
${idRule}
- <summary>: lowercase, imperative, covering all commits, no trailing period, no PR number such as (#123)
- example: feat(ABC-123,api,cli): add token refresh to the api client and expose it in the cli"

  # prompt only: no tools, no MCP servers, no user / project settings ( hooks, plugins, CLAUDE.md )
  local -a aiCmd=( claude -p --model "${model}" --tools '' --strict-mcp-config --setting-sources ''
                   --no-session-persistence --system-prompt "${rules}"
                 )
  local to="$( type -P timeout gtimeout | head -1 || : )"
  # --foreground: stay in the caller's process group ( INT / TERM / HUP reach it, the EXIT trap runs at once )
  test -n "${to}" && aiCmd=( "${to}" --foreground "${secs}" "${aiCmd[@]}" )

  local cli="$( command -v claude )"
  show info "generating PR title for $(c 0Mi)$(git rev-list --count "${range}")$(c 0Wdi) commits via \`$(c 0Yi)${cli/#${HOME}\//\~\/} --model ${model}$(c 0Wdi)\` ..."
  local out='' err='' rc=0
  local errFile="$( mktemp )"
  # shellcheck disable=SC2064
  trap "rm -f '${errFile}'" EXIT
  trap 'exit 130' INT TERM HUP
  out="$( printf '%s' "${commits}" | "${aiCmd[@]}" 2>"${errFile}" )" || rc=$?
  err="$( tail -n 1 "${errFile}" )"
  if test 0 -ne "${rc}"; then
    # timeout exits 124; claude -p may print the error on stdout instead of stderr
    test 124 -eq "${rc}" && err="timed out after ${secs}s" || err="exit ${rc}: ${err:-$( tail -n 1 <<< "${out}" )}"
    show warning "claude failed ( ${err} ), fallback to the latest commit subject"
    return 0
  fi

  # first valid title line: conventional-commit format, <= maxLen, every JIRA ID inside the scope
  local -r wrapRe='^[`"'"'"'](.*)[`"'"'"']$'
  local -r titleRe='^(feat|fix|chore|docs|refactor|perf|test|build|ci|style|revert)(\(([A-Za-z0-9._/-]+(,[A-Za-z0-9._/-]+)*)\))?!?: [^[:space:]]'
  local line first='' scope id ok
  while IFS= read -r line; do
    # drop CR, trim spaces, unwrap surrounding backtick/quote
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ "${line}" =~ ${wrapRe} ]] && line="${BASH_REMATCH[1]}"
    test -z "${line}" && continue
    test -z "${first}" && first="${line}"
    [[ "${line}" =~ ${titleRe} ]] && test "${#line}" -le "${maxLen}" || continue
    scope=",${BASH_REMATCH[3]},"
    ok=true
    for id in "${ids[@]}"; do [[ "${scope}" == *",${id},"* ]] || ok=false; done
    "${ok}" && { printf '%s' "${line}"; return 0; }
  done <<< "${out}"

  show warning "invalid AI title, fallback to the latest commit subject: \`${first}\`"
}

function prCmd() {
  # nameref
  local -n arrRef=$1

  local main=''
  test -f "$(git rev-parse --absolute-git-dir)"/refs/remotes/origin/HEAD &&
    main="$(git symbolic-ref --short refs/remotes/origin/HEAD | sed 's|^origin/||')" ||
    main="$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name)"

  local current="$(git branch --show-current)"
  test -z "${current}" && show error 'Not in a git repository or detached HEAD'
  isPushed "${current}" "${main}"
  local gpreview="git show --color=always origin/{-1}"

  local base=$({
                 echo "${main}";
                 git for-each-ref refs/remotes/origin --sort=-committerdate --format="%(refname:lstrip=3)"
               } |
               awk 'NF && $0!~/^(HEAD|origin)$/ && !seen[$0]++' |
               grep -v --color=never -E "^(${current})$" |
               fzf --no-multi --ansi --prompt='base branch:  ' -0 \
                   --height 50% --min-height 10+ \
                   --style full --no-input-border \
                   --preview "${gpreview} -s" \
                   --preview-window=right,55%,nofollow --preview-label-pos='bottom' \
                   --bind "ctrl-o:execute(${gpreview})+change-preview(${gpreview} -s)+change-prompt( )" \
                   --bind 'ctrl-/:change-preview-window:up,60%|hidden|right,55%' \
                   --bind 'ctrl-y:execute-silent(git log origin/{-1} -1 --pretty=format:"%H" | pbcopy)'
              )

  test -z "${base:-}" && show error 'no branch selected, aborting PR creation'
  "${DRYRUN}" || show info "drafting PR : \`$(c 0Yi)${current}$(c 0Wdi)\` -> \`$(c 0Yi)${base}$(c 0Wdi)\`"

  local label=''
  _labelExists 'auto-merge' && label='auto-merge'

  # TODO: using AI to generate better body
  local title=$(git log -1 --pretty=%s)
  # full message of every commit in `base..HEAD`, oldest first, joined by `---` ( no trailing separator ), PR ref stripped via `PR_RE`
  local body='' sep='' sha
  while IFS= read -r sha; do
    body+="${sep}$(git log -1 --pretty=%B "${sha}" | sed -E "${PR_RE}")"
    sep=$'\n\n---\n\n'
  done < <( git rev-list --reverse "origin/${base}..HEAD" )
  # multi-commit PR: one title from all commits via `claude`; the latest subject on any failure
  if "${AI}" && test "$( git rev-list --count "origin/${base}..HEAD" )" -gt 1; then
    local aiOut="$(aiTitle "origin/${base}..HEAD" "${body}")"
    test -n "${aiOut}" && title="${aiOut}" || :
  fi
  test -z "${body}" && body="auto-generated PR from commit: '${title}'"

  local url="${JIRA_URL:-https://jira.domain.com}"
  body=$(echo "${body}" | sed -E "s#(^|[^A-Za-z0-9])([A-Z][A-Z0-9]+-[0-9]+)#\1[\2](${url}/browse/\2)#g")

  # shellcheck disable=SC2034
  arrRef=( gh pr create
              --base "${base}"
              --head "${current}"
              --title "${title}"
              --body "${body}"
         )
  if test -n "${label:-}"; then arrRef+=( --label "${label}" ); fi
}

function checkTools() {
  local -a tools=( 'gh' 'fzf' )
  local -a missing=()

  for tool in "${tools[@]}"; do
    type -P "${tool}" >/dev/null 2>&1 || missing+=( "${tool}" )
  done

  if [[ ${#missing[@]} -gt 0 ]]; then
    show error "missing required tools: $(c 0Mi)$(joinBy ', ' "${missing[@]}")$(c)"
  fi
}

function openPR() {
  local prId="${1:-}"

  if "${OPEN}"; then
    test -z "${prId:-}" && prId="$(gh pr view --json number -q .number 2>/dev/null)";
    # shellcheck disable=SC2015
    test -n "${prId:-}" && {
      local -a openCmd=( gh pr view "${prId}" --web )
      "${VERBOSE}" && show info "opening PR $(c 0Mi)\`#${prId}\`$(c 0Wdi) in web browser ...$(c)" || :
      "${openCmd[@]}"
    } || {
      show warning "cannot open PR: no PR ID found"
    }
  fi
}

function main() {
  local PR_ID=''
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o | --open    ) OPEN=true                   ; shift   ;;
      -a | --auto    ) OPEN=true; AUTO=true        ; shift   ;;
      -l | --label   ) LABELS+=( "${2}" )          ; shift 2 ;;
      -d | --draft   ) GH_OPTS+=( --draft )        ; shift   ;;
      -v | --verbose ) VERBOSE=true                ; shift   ;;
      -D | --dryrun  ) DRYRUN=true                 ; shift   ;;
      --no-ai        ) AI=false                    ; shift   ;;
      --             ) shift; GH_OPTS+=( "$@" )    ; break   ;;
      -h | --help    ) showHelp                              ;;
      *              ) show error "unknown argument: \`$1\`" ;;
    esac
  done

  if "${AUTO}" && PR_ID=$(gh pr view --json number -q .number 2>/dev/null); then
    show info "existing PR found: \`$(c 0Mi)#${PR_ID}$(c 0Wdi)\`, opening it ...$(c)"
    openPR "${PR_ID}" && exit 0
  fi

  prCmd CLI_CMD

  { "${DRYRUN}" || "${VERBOSE}"; } && {
    # copy-pasteable preview: safe tokens bare, @Q-quote only args with shell-special chars ( space, (), backtick, #, quote )
    local -a preview=()
    local arg
    for arg in "${CLI_CMD[@]}" "${GH_OPTS[@]}"; do
      if [[ "${arg}" =~ ^[A-Za-z0-9_./:=@%+,-]+$ ]]; then preview+=( "${arg}" ); else preview+=( "${arg@Q}" ); fi
    done
    local msg="command to be executed: \`$(c 0Cdi)\$ ${preview[*]}$(c 0Wdi)\` ...$(c)"
    # shellcheck disable=SC2015
    "${DRYRUN}" && { show dryrun "${msg}"; exit 0; } || show verbose "${msg}"
  }

  # new PR
  "${CLI_CMD[@]}" "${GH_OPTS[@]}"

  # add labels
  if [[ ${#LABELS[@]} -gt 0 ]] && PR_ID="$(gh pr view --json number -q .number 2>/dev/null)" && [[ -n "${PR_ID}" ]]; then
    local -a labels=()
    local -a _labels=()
    for iterm in "${LABELS[@]}"; do
      IFS=',' read -ra _labels <<< "${iterm}"
      for _label in "${_labels[@]}"; do
        [[ "${_label}" == 'auto-merge' ]] && continue
        if   _labelExists "${_label}"; then labels+=( "${_label}" );
        else show warning "label \`${_label}\` not found in repo, skipping";
        fi
      done
    done
    [[ ${#labels[@]} -gt 0 ]] && gh pr edit "${PR_ID}" --add-label "$( joinBy ',' "${labels[@]}" )"
  fi

  "${DRYRUN}" || openPR
}

checkTools
main "$@"

